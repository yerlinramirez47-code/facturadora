# Copia este archivo como .env solo para pruebas en tu computadora (Bun lo lee solo).
# En Railway, estas variables se ponen en la pestaña "Variables" del servicio.

# Conexión a PostgreSQL. En Railway usa la referencia: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:clave@localhost:5432/facturadora

# Administrador inicial: se crea al arrancar si ese usuario aún no existe.
# La contraseña debe tener al menos 8 caracteres.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Opcional: nombre de la tienda antes de configurarlo en la app (menú "Tienda").
TIENDA_NOMBRE=Mi Tienda

# Opcional: forzar o desactivar SSL hacia la base de datos (true / false).
# Si no la pones, es automático: sin SSL en la red privada de Railway y en localhost.
# DATABASE_SSL=
